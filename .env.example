# In development, leave VITE_API_URL unset so Vite proxies /api to the Express server.
VITE_API_PROXY_TARGET=http://localhost:3000
# For a separately deployed API, set its complete /api URL, for example:
# VITE_API_URL=https://api.example.com/api
VITE_MAPBOX_TOKEN=your-public-mapbox-token

# ── Campify AI Chatbot (campify-chatbot microservice) ──
# Local dev: http://localhost:4000
# Production: https://your-chatbot-service.onrender.com
VITE_CHATBOT_URL=http://localhost:4000
